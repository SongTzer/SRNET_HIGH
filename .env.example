# ---------------------------------------------------------------------------
# FinLab 憑證（headless / CI 用）
#
# 本機第一次使用請直接跑瀏覽器登入，不需要填這裡：
#     python -m finlab login
#
# 登入成功後，若要把憑證帶到伺服器 / GitHub Actions，執行：
#     python -m finlab token
# 把輸出的三行貼到 .env（三個都要，缺一 finlab 會退回瀏覽器登入）
# ---------------------------------------------------------------------------
FINLAB_REFRESH_TOKEN=
FINLAB_SESSION_ID=
FINLAB_API_KEY=
